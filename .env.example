# Copy to .env.local for local development, or pass as --build-arg at Docker build time.
# Point to the auction-it Node API base URL (no trailing slash).
#
# Local dev (API running directly):
#   VITE_API_URL=http://localhost:4000
#
# LAN / staging (through nginx at http://10.10.13.189/api/v1):
#   VITE_API_URL=http://10.18.16.189/api/v1
#
# Production:
#   VITE_API_URL=https://api.auctionit.ai
VITE_API_URL=http://localhost:4000
